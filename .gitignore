# Python
backend/.venv/
__pycache__/
*.pyc
backend/.env

# Node
frontend/node_modules/
# NOTE: frontend/dist IS committed so the app runs with only Python (no Node
# needed just to run it). Rebuild it with `npm run build` when the UI changes.

# Generated media
data/uploads/*
data/outputs/*
!data/uploads/.gitkeep
!data/outputs/.gitkeep

# Piper voice models (large, re-downloadable)
backend/voices/*.onnx
backend/voices/*.onnx.json
backend/voices/*.wav

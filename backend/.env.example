# Copy to .env and fill in. Never commit .env.

# Which backend runs Wan: fal | replicate | local
WAN_PROVIDER=fal

# --- fal.ai (hosted GPU) ---
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# --- replicate.com (hosted GPU) ---
# Get a token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# --- Motion generation (Motion tab) ---
# Base model: ltx (efficient, best for long clips on a free GPU) | wan
MOTION_MODEL=ltx
# Where motion runs: fal | replicate | local (defaults to WAN_PROVIDER)
# MOTION_PROVIDER=local
# Seconds per generated segment (long clips chain segments together)
SEGMENT_SECONDS=5

# --- Optional: override which Wan model each provider uses ---
# FAL_T2V_MODEL=fal-ai/wan-t2v
# FAL_I2V_MODEL=fal-ai/wan-i2v
# REPLICATE_T2V_MODEL=wan-video/wan-2.2-t2v-fast
# REPLICATE_I2V_MODEL=wan-video/wan-2.2-i2v-fast

# --- Local Wan (GPU box only) ---
# WAN_LOCAL_MODEL=Wan-AI/Wan2.1-T2V-1.3B-Diffusers

# --- Voice / TTS ---
# Defaults to local Piper (free, CPU) whenever voices exist in backend/voices/.
# Force a backend explicitly if you like: piper | fal | replicate
# TTS_PROVIDER=piper
# PIPER_VOICES_DIR=voices          # where the .onnx voices live
# PIPER_MODEL=                     # optional explicit default voice .onnx path
